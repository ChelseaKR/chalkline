{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {"include": ["refs/heads/main"], "exclude": []}
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "verify"},
          {"context": "audit"},
          {"context": "secret-scan"},
          {"context": "sast"},
          {"context": "zizmor"},
          {"context": "analyze"}
        ]
      }
    }
  ],
  "bypass_actors": []
}
