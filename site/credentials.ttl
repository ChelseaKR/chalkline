    a ceterms:ConditionProfile ;
    ceterms:condition "Complete a Commission-approved school nurse program and obtain the formal recommendation of the program sponsor."@en-us,
        "Complete two years of successful experience as a school nurse (If the Preliminary School Nurse Credential was issued on or before July 1, 1981, this experience is not required)."@en-us,
        "Individuals must receive the formal recommendation of a Commission-approved school nurse program and must satisfy all of the following requirements:"@en-us,
        "Verify possession of a Preliminary School Nurse Services Credential."@en-us,
        "Verify possession of a valid Registered Nurse License issued by the State of California."@en-us ;
    ceterms:name "Requirements for the Clear Credential"@en-us ;
    ceterms:subjectWebpage <https://www.ctc.ca.gov/credentials/leaflets/cl-380/> .

