_:c14n1468
    a ceterms:ConditionProfile ;
    ceterms:condition "Beginning 7/1/2023 , have three or more years of full-time teaching experience in a transitional kindergarten setting, preschool age early childhood or child development program, or a combination of these experiences."@en-us,
        "Possession a valid Child Development Teacher Permit or higher."@en-us,
        "Possession of a baccalaureate degree or higher from a regionally-accredited college or university."@en-us,
        "Possession of a baccalaureate or higher degree in Child Development, Early Childhood Education or a similar major."@en-us,
        "Satisfaction of one of the following: 24 semester units of coursework in the field of Child Development or Early Childhood Education from a regionally-accredited college or university."@en-us,
        "Submission of a completed application (form 41-4) and processing fee ."@en-us,
        "The employing agency must have an annual Declaration of Need for Fully Qualified Educators (form CL-500) on file with the Commission."@en-us,
        "Verification of meeting the initial requirements by submission of a completed form CL-908 ."@en-us ;
    ceterms:name "Requirements for Initial Issuance"@en-us ;
    ceterms:subjectWebpage <https://www.ctc.ca.gov/credentials/leaflets/cl-909/> .

