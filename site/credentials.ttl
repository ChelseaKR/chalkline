_:c14n1097
    a ceterms:ConditionProfile ;
    ceterms:condition "A photocopy of a valid Registered Nurse License issued by the State of California. If you do not hold the license, contact the Board of Registered Nursing , 1747 North Market Boulevard, Suite 150, Sacramento, CA 95834, 916-322-3350."@en-us,
        "Application processing fee ."@en-us,
        "Individuals must satisfy all of the following:"@en-us,
        "Official transcripts showing a baccalaureate or higher degree from a regionally-accredited college or university."@en-us,
        "Visit Direct Application Submission for instructions on submitting your application online, and if not previously submitted to the Commission, evidence of fingerprint processing (see Fees and Fingerprinting ). A checklist of required documentation can be accessed on the Preliminary School Nurse Services Credential Checklist webpage. Please note that the checklist itself is not required to submit."@en-us ;
    ceterms:name "Requirements for the Preliminary Credential"@en-us ;
    ceterms:subjectWebpage <https://www.ctc.ca.gov/credentials/leaflets/cl-380/> .

