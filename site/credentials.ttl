<https://chalkline.chelseakr.com/ctdl/resources/ce-803d1171-2472-469a-bd31-94573f7b11ac>
    a ceterms:License ;
    ceterms:ctid "ce-803d1171-2472-469a-bd31-94573f7b11ac" ;
    ceterms:description "The Teacher Librarian Services Credential authorizes the holder to perform all of the following duties:\nInstruct students in accessing, evaluating, using and integrating information and resources in the library program\nPlan and coordinate school library programs with the instructional programs of a school district through collaboration with teachers\nSelect materials for school and district libraries\nDevelop programs for and deliver staff development for school library services\nCoordinate or supervise library programs at the school, district or county level\nPlan and conduct a course of instruction for those pupils who assist in the operation of school libraries\nSupervise classified personnel assigned school library duties\nDevelop procedures for and management of the school and district libraries"@en-us ;
    ceterms:identifier _:c14n367,
        _:c14n595 ;
    ceterms:inLanguage "en-US"^^<http://www.w3.org/2001/XMLSchema#language> ;
    ceterms:name "Teacher Librarian Services Credential"@en-us ;
    ceterms:ownedBy <https://chalkline.chelseakr.com/ctdl/resources/ce-58d1aa00-cd57-4d91-9639-49bc92c5e96e> ;
    ceterms:regulatedIn _:c14n158 ;
    ceterms:requires _:c14n14 ;
    ceterms:subjectWebpage <https://www.ctc.ca.gov/credentials/leaflets/cl-562/> .

