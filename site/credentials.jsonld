      "ceterms:name": {
        "en-US": "School Nurse Services Credential"
      },
      "ceterms:description": {
        "en-US": "Holders of the School Nurse Services Credential shall be authorized to perform the following services:\nConduct immunization programs pursuant to California Education Code, Section 49403, of the California Code of Regulations.\nAssess and evaluate the health and developmental status of pupils.\nInterpret the health and developmental assessment to parents, teachers, administrators, and other professionals directly concerned with the pupil.\nDesign and implement individual student health maintenance plans, incorporating plans directed by a physician.\nRefer the pupil and parent or guardian to appropriate community resources for necessary services.\nMaintain communication with parents and all involved community practitioners and agencies to promote needed treatment and secure reports of findings pertinent to educational planning.\nInterpret medical and nursing findings appropriate to the student’s individualized education program and make recommendations to professional personnel directly involved.\nConsult with, conduct in-service training for, and serve as a resource person to teachers and administrators.\nDevelop and implement the health education curriculum.\nAct as a participant in implementing a comprehensive health instruction curriculum for students.\nCounsel and assist pupils and parents in health-related and school adjustment services.\nTeach health-related subjects under the supervision of a classroom teacher"
      },
      "ceterms:inLanguage": [
        "en-US"
      ],
      "ceterms:subjectWebpage": "https://www.ctc.ca.gov/credentials/leaflets/cl-380/",
      "ceterms:ownedBy": [
        "https://chalkline.chelseakr.com/ctdl/resources/ce-58d1aa00-cd57-4d91-9639-49bc92c5e96e"
      ],
      "ceterms:regulatedIn": [
        {
          "@type": "ceterms:JurisdictionProfile",
          "ceterms:description": {
            "en-US": "The Commission on Teacher Credentialing issues and regulates these credentials for service in California public schools."
          },
          "ceterms:mainJurisdiction": {
            "@type": "ceterms:Place",
            "ceterms:name": {
              "en-US": "California"
            },
            "ceterms:addressRegion": {
              "en-US": "California"
            },
            "ceterms:addressCountry": {
              "en-US": "United States"
            }
          }
        }
      ],
      "ceterms:identifier": [
        {
          "@type": "ceterms:IdentifierValue",
          "ceterms:identifierTypeName": {
            "en-US": "CTC Document Title code"
          },
          "ceterms:identifierValueCode": "SC3A"
        },
        {
          "@type": "ceterms:IdentifierValue",
          "ceterms:identifierTypeName": {
            "en-US": "CTC Authorization Code"
          },
          "ceterms:identifierValueCode": "R52N"
        }
      ],
      "ceterms:requires": [
        {
          "@type": "ceterms:ConditionProfile",
          "ceterms:name": {
            "en-US": "Requirements for the Preliminary Credential"
          },
          "ceterms:condition": {
            "en-US": [
              "Individuals must satisfy all of the following:",
              "Official transcripts showing a baccalaureate or higher degree from a regionally-accredited college or university.",
              "A photocopy of a valid Registered Nurse License issued by the State of California. If you do not hold the license, contact the Board of Registered Nursing , 1747 North Market Boulevard, Suite 150, Sacramento, CA 95834, 916-322-3350.",
              "Visit Direct Application Submission for instructions on submitting your application online, and if not previously submitted to the Commission, evidence of fingerprint processing (see Fees and Fingerprinting ). A checklist of required documentation can be accessed on the Preliminary School Nurse Services Credential Checklist webpage. Please note that the checklist itself is not required to submit.",
              "Application processing fee ."
            ]
          },
          "ceterms:subjectWebpage": "https://www.ctc.ca.gov/credentials/leaflets/cl-380/"
        },
        {
          "@type": "ceterms:ConditionProfile",
          "ceterms:name": {
            "en-US": "Requirements for the Clear Credential"
          },
          "ceterms:condition": {
            "en-US": [
              "Individuals must receive the formal recommendation of a Commission-approved school nurse program and must satisfy all of the following requirements:",
              "Verify possession of a Preliminary School Nurse Services Credential.",
              "Verify possession of a valid Registered Nurse License issued by the State of California.",
              "Complete two years of successful experience as a school nurse (If the Preliminary School Nurse Credential was issued on or before July 1, 1981, this experience is not required).",
              "Complete a Commission-approved school nurse program and obtain the formal recommendation of the program sponsor."
            ]
          },
          "ceterms:subjectWebpage": "https://www.ctc.ca.gov/credentials/leaflets/cl-380/"
        }
      ],
      "ceterms:renewal": [
        {
          "@type": "ceterms:ConditionProfile",
          "ceterms:name": {
            "en-US": "Requirements for Renewing the Clear Credential"
          },
          "ceterms:condition": {
            "en-US": [
              "Individuals must satisfy all of the following:",
              "Verify possession of a valid Registered Nurse License issued by the State of California.",
              "Submit an online renewal application .",
              "Application processing fee ."
            ]
          },
          "ceterms:subjectWebpage": "https://www.ctc.ca.gov/credentials/leaflets/cl-380/"
        },
        {
          "@type": "ceterms:ConditionProfile",
          "ceterms:name": {
            "en-US": "Term of the Credential"
          },
          "ceterms:condition": {
            "en-US": [
              "The preliminary credential is issued for five calendar years and is not renewable. The clear credential is issued for five calendar years and must be renewed with a paper application packet."
            ]
          },
          "ceterms:subjectWebpage": "https://www.ctc.ca.gov/credentials/leaflets/cl-380/"
        }
      ]
    },
